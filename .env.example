# GEMINI_API_KEY: Optional for AI Studio runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL Database Configuration (USMBA DOCTORIA System)
# Connect to a hosted PostgreSQL instance (e.g., Supabase, Neon, local pg, or Cloud SQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/doctoria_usmba"
PGHOST="localhost"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD="password"
PGDATABASE="doctoria_usmba"

# JWT and Session Security
JWT_SECRET="doctoria_usmba_jwt_secret_key_2026_fes"

# Port configuration (Required 3000 in AI Studio)
PORT="3000"

